---
import { Image } from 'astro:assets';
import headshotImage from '../assets/Salvador_Headshot_Primary.png';
---
<section class="py-20 md:py-32 flex flex-col md:flex-row items-center justify-center gap-12 md:gap-20 bg-navy relative overflow-hidden px-6">
  <div class="absolute inset-0 bg-gradient-to-b from-teal/5 to-transparent pointer-events-none"></div>
  
  {/* Text Content */}
  <div class="space-y-8 max-w-2xl text-center md:text-left relative z-10">
    <div class="space-y-4">
      <h2 class="text-sm font-mono uppercase tracking-[0.2em] text-teal">Senior SON Architect</h2>
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-white tracking-tight leading-tight">
        Industrializing SON Outcomes <br class="hidden md:block" /> via <span class="text-teal">SMO-Driven Automation</span>
      </h1>
      <p class="text-xl text-slate max-w-xl mx-auto md:mx-0 font-light leading-relaxed">
        Designing production-grade cSON architectures and SMO-driven automation to transform RAN operations.
      </p>
    </div>
    
    <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
      <a href="mailto:josaiblu2@yahoo.com.mx" class="px-8 py-4 bg-teal text-navy font-bold rounded-lg hover:bg-teal/90 transition-all transform hover:-translate-y-1 shadow-lg shadow-teal/20 text-lg">
        Contact for Collaboration
      </a>
      <button type="button" id="cv-request-trigger" class="px-8 py-4 border-2 border-slate text-slate font-bold rounded-lg hover:border-teal hover:text-teal transition-all text-lg">
        Request CV
      </button>
    </div>
  </div>

  {/* Hero Image */}
  <div class="relative z-10 shrink-0">
    <div class="relative">
      <div class="absolute inset-0 bg-teal/20 rounded-full blur-2xl transform translate-y-4"></div>
      <Image
        src={headshotImage}
        width={800}
        height={800}
        format="webp"
        quality={80}
        loading="eager"
        fetchpriority="high"
        alt="Salvador Ibarra"
        class="relative w-64 h-64 md:w-80 md:h-80 lg:w-96 lg:h-96 object-cover rounded-full border-2 border-[#14B8A6] shadow-2xl"
      />
    </div>
  </div>
</section>

{/* Phase 1, Task 3 (EXP-003): CV download modal, gated behind an email capture form. */}
<dialog id="cv-request-modal" class="p-0 bg-transparent backdrop:bg-navy/90 w-full max-w-md h-fit m-auto rounded-2xl shadow-2xl">
  <div class="bg-[#020617] border border-teal/40 rounded-2xl p-8 md:p-10 shadow-2xl shadow-teal/10 relative text-left">
    <button
      type="button"
      id="cv-request-close"
      aria-label="Close"
      class="absolute top-4 right-4 p-2 text-slate-300 hover:text-teal transition-colors rounded-full hover:bg-white/5"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div id="cv-request-form-view">
      <h3 class="text-2xl text-white font-bold mb-2 pr-8">Download my CV</h3>
      <p class="text-slate text-sm mb-6">
        Enter your professional email to download the CV as a PDF.
      </p>

      <form id="cv-request-form" name="cv-request" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="space-y-4">
        <input type="hidden" name="form-name" value="cv-request" />
        <p class="hidden" style="display:none">
          <label>Don't fill this out if you're human: <input name="bot-field" /></label>
        </p>

        <div class="space-y-2">
          <label for="cv-email" class="block text-sm font-mono text-slate-300">
            Professional email <span class="text-teal">*</span>
          </label>
          <input
            type="email"
            id="cv-email"
            name="email"
            required
            class="w-full bg-navy/50 border border-slate/30 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-teal focus:ring-1 focus:ring-teal transition-all placeholder-slate/30"
            placeholder="john@company.com"
          />
        </div>

        <p id="cv-request-error" class="hidden text-red-400 text-sm"></p>

        <button
          type="submit"
          id="cv-request-submit"
          class="w-full px-8 py-4 bg-teal text-navy font-bold rounded-lg hover:bg-[#2DD4BF] hover:shadow-[0_0_20px_rgba(20,184,166,0.4)] transition-all duration-300"
        >
          Download CV
        </button>
      </form>
    </div>

    {/* Success view: shown after a confirmed Netlify Forms submission. Not auto-dismissed,
        and always includes a real, directly-clickable fallback link to the PDF so the
        visitor can retrieve it even if the automatic download attempt is blocked by the
        browser (this can happen after an awaited network call breaks the "user gesture"
        chain some browsers require for automatic downloads). */}
    <div id="cv-request-success-view" class="hidden text-center space-y-5">
      <div class="w-14 h-14 bg-teal/10 rounded-full flex items-center justify-center mx-auto text-teal">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <div>
        <h3 class="text-xl text-white font-bold mb-2">Thanks! Your download should start automatically.</h3>
        <p class="text-slate text-sm">If it doesn't start in a few seconds, use the button below.</p>
      </div>
      <a
        id="cv-request-fallback-link"
        href="/assets/cv/Salvador_Ibarra_Luna_CV_Master_v1_3.pdf"
        download="Salvador_Ibarra_Luna_CV.pdf"
        class="inline-flex w-full items-center justify-center px-8 py-4 bg-teal text-navy font-bold rounded-lg hover:bg-[#2DD4BF] transition-all duration-300"
      >
        Download CV (PDF)
      </a>
      <button
        type="button"
        id="cv-request-done"
        class="text-slate-300 hover:text-teal transition-colors text-sm font-mono"
      >
        Close
      </button>
    </div>
  </div>
</dialog>

<script>
  const cvTrigger = document.getElementById('cv-request-trigger');
  const cvModal = document.getElementById('cv-request-modal') as HTMLDialogElement | null;
  const cvClose = document.getElementById('cv-request-close');
  const cvFormView = document.getElementById('cv-request-form-view');
  const cvSuccessView = document.getElementById('cv-request-success-view');
  const cvForm = document.getElementById('cv-request-form') as HTMLFormElement | null;
  const cvSubmit = document.getElementById('cv-request-submit') as HTMLButtonElement | null;
  const cvError = document.getElementById('cv-request-error');
  const cvDone = document.getElementById('cv-request-done');

  const CV_PDF_URL = '/assets/cv/Salvador_Ibarra_Luna_CV_Master_v1_3.pdf';

  function resetCvModalState() {
    cvError?.classList.add('hidden');
    cvFormView?.classList.remove('hidden');
    cvSuccessView?.classList.add('hidden');
    cvForm?.reset();
    if (cvSubmit) {
      cvSubmit.disabled = false;
      cvSubmit.textContent = 'Download CV';
    }
  }

  cvTrigger?.addEventListener('click', () => {
    resetCvModalState();
    cvModal?.showModal();
  });

  cvClose?.addEventListener('click', () => cvModal?.close());
  cvDone?.addEventListener('click', () => cvModal?.close());
  cvModal?.addEventListener('close', resetCvModalState);

  cvForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!cvForm || !cvSubmit) return;

    cvError?.classList.add('hidden');
    cvSubmit.disabled = true;
    cvSubmit.textContent = 'Sending...';

    try {
      const formData = new FormData(cvForm);
      const body = new URLSearchParams(formData as any).toString();

      const response = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body,
      });

      if (!response.ok) {
        throw new Error('Netlify Forms returned an error response');
      }

      // GA4 Tier 1 event, distinct and separate from the contact form's event (EXP-002).
      if (typeof (window as any).gtag === 'function') {
        (window as any).gtag('event', 'tier1_cv_download_conversion', {
          event_category: 'Tier1_Conversion',
          event_label: 'cv_download',
          transport_type: 'beacon',
        });
      }

      // Best-effort automatic download. Some browsers can silently drop a
      // programmatic download after an awaited network call, which is exactly
      // why the success view below always also offers a real, directly
      // clickable link to the same file as a guaranteed fallback.
      try {
        const link = document.createElement('a');
        link.href = CV_PDF_URL;
        link.download = 'Salvador_Ibarra_Luna_CV.pdf';
        document.body.appendChild(link);
        link.click();
        link.remove();
      } catch (downloadErr) {
        console.warn('Automatic CV download attempt failed, fallback link is available.', downloadErr);
      }

      cvFormView?.classList.add('hidden');
      cvSuccessView?.classList.remove('hidden');
    } catch (err) {
      console.error('CV request submission failed', err);
      if (cvError) {
        cvError.textContent = "We couldn't process your request. Please check your connection and try again.";
        cvError.classList.remove('hidden');
      }
    } finally {
      cvSubmit.disabled = false;
      cvSubmit.textContent = 'Download CV';
    }
  });
</script>

<style>
  #cv-request-modal::backdrop {
    backdrop-filter: blur(8px);
  }

  #cv-request-modal[open] {
    animation: cvModalZoomIn 0.3s ease-out;
  }

  @keyframes cvModalZoomIn {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>
